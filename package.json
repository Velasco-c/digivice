{
  "name": "digivice-os",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Digivice estilo GameBoy reconstruido con React, TypeScript, Vite y animaciones de alto nivel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx gh-pages -d dist"
  },
  "dependencies": {
    "framer-motion": "^14.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
